# ===== 应用 =====
PORT=3000
JWT_SECRET=change-me-to-32-bytes-random-value!
# ===== 数据层（方案 A：pgvector 同库）=====
DATABASE_URL=postgresql://nestkb:nestkb@localhost:5433/nestkb   # Prisma 用
PGVECTOR_URL=postgresql://nestkb:nestkb@localhost:5433/nestkb   # VectorStore 专用 Pool
REDIS_URL=redis://localhost:6380/0
STORAGE_DIR=storage/uploads
# ===== LLM 门面（provider 全配置化，业务代码不出现模型名）=====
# provider 可选：openai-compat | mock（mock：本地确定性桩，无需 API key 即可跑通全链路）
LLM_CHAT_PROVIDER=mock
LLM_CHAT_BASE_URL=https://api.example-llm.com/v1
LLM_CHAT_API_KEY=sk-xxxxxxxx
LLM_CHAT_MODEL=your-chat-model
LLM_CHAT_TEMPERATURE=0.2
LLM_EMBEDDING_PROVIDER=mock
LLM_EMBEDDING_BASE_URL=https://api.example-llm.com/v1
LLM_EMBEDDING_API_KEY=sk-xxxxxxxx
LLM_EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIM=1024                          # 必须与模型真实维度一致（pnpm doctor 探针验证）
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RPM=1200
LLM_RERANK_PROVIDER=mock
LLM_RERANK_BASE_URL=https://api.example-rerank.com/v1
LLM_RERANK_API_KEY=sk-xxxxxxxx
LLM_RERANK_MODEL=your-reranker
RERANK_TIMEOUT_MS=800                       # 超时降级为 RRF 粗排
# 元/百万 token，成本看板与预算闸唯一依据
PRICE_JSON={"your-chat-model":{"input":2,"output":8},"your-embedding-model":{"input":0.5},"your-reranker":{"per_call":0.001}}
RETRIEVAL_TOPK_COARSE=50                    # 双路各自粗排池
RETRIEVAL_TOPK_FINAL=8                      # 进 prompt 的最终块数
RRF_K=60                                    # RRF 平滑常数
DEPT_MONTHLY_QUOTA_CNY=50                   # 部门月预算（元），departments.quota_month 同源
QA_REQUEST_LIMIT_PER_MIN=5                  # 用户级限流
SEMANTIC_CACHE_ENABLED=false                # 语义缓存（保守档，默认关闭）
HISTORY_MAX_TURNS=8                         # 超过后摘要化压缩
HISTORY_KEEP_RECENT=4                       # 压缩后保留最近轮数
EVAL_JUDGE_SAMPLES=1                        # 忠实度 judge 采样次数（正式基线建议 3）
MOCK_STREAM_DELAY_MS=0                      # mock provider 流式模拟延迟
