{
  "name": "nestkb",
  "version": "0.1.0",
  "description": "NestKB —— 企业知识库 AI 问答助手（RAG 全链路工程化）",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "concurrently -n api,worker,web -c cyan,magenta,green \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:api": "nest start api --watch",
    "dev:worker": "nest start worker --watch",
    "build": "nest build api && nest build worker",
    "start:api": "node -r ./scripts/runtime-paths.js dist/apps/api/apps/api/src/main.js",
    "start:worker": "node -r ./scripts/runtime-paths.js dist/apps/worker/apps/worker/src/main.js",
    "migrate": "prisma migrate dev",
    "deploy:migrate": "prisma migrate deploy",
    "seed": "ts-node -r tsconfig-paths/register --transpile-only scripts/seed.ts",
    "seed:docs": "ts-node -r tsconfig-paths/register --transpile-only scripts/seed-docs.ts",
    "doctor": "ts-node -r tsconfig-paths/register --transpile-only scripts/doctor.ts",
    "eval": "ts-node -r tsconfig-paths/register --transpile-only eval/scripts/run-eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build:web": "pnpm -C apps/web build",
    "dev:web": "pnpm -C apps/web dev"
  },
  "dependencies": {
    "@bull-board/api": "^6.10.1",
    "@bull-board/fastify": "^6.10.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.52.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.11.3",
    "ioredis": "^5.6.1",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.0",
    "prisma": "^6.10.0",
    "tsconfig-paths": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.28",
    "@fastify/static": "^8.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/core": "^1.11.31",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "unplugin-swc": "^1.5.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  }
}